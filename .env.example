# ---------------------------------------------------------------------------
# Ledgermancy configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=ledgermancy
POSTGRES_PASSWORD=change-me-in-your-env-file
POSTGRES_DB=ledgermancy
# Host port for local psql access only. Bound to 127.0.0.1 (loopback), so it
# is NOT reachable from the network. The api/worker never use this — they
# reach the database at postgres:5432 over the compose network. The prod
# overlay removes the mapping entirely. Change it if 5433 is already taken.
POSTGRES_HOST_PORT=5433
# Used by the api/worker containers to reach the postgres service.
DATABASE_URL=postgres://ledgermancy:change-me-in-your-env-file@postgres:5432/ledgermancy?sslmode=disable

# --- Server -----------------------------------------------------------------
APP_ENV=development
HTTP_ADDR=:8080
# Origin the browser loads the frontend from (CORS + cookie settings).
FRONTEND_ORIGIN=http://localhost:5173

# Host port the frontend (nginx) container publishes. It serves the built UI
# and proxies /api and /webhooks to the api over the internal network. In
# production this is the port your TLS-terminating reverse proxy forwards to.
FRONTEND_HOST_PORT=8081

# Loopback host port for the api, used ONLY in local development (the vite dev
# server proxies /api here). The prod overlay removes the api's host port
# entirely, so this has no effect in production.
API_HOST_PORT=8080

# Whether to believe X-Forwarded-For / X-Forwarded-Proto on incoming requests.
#
# Leave this false here. The prod overlay sets it to true for you, and it is
# only safe there: that overlay removes the api's host port entirely, so the
# bundled nginx — which strips client-supplied address headers — is the only
# way in.
#
# Turning it on without a sanitising proxy in front lets any caller choose its
# own apparent IP address, which defeats every per-IP rate limit and poisons
# the security audit log. Leaving it off when there IS such a proxy is merely
# lossy: every request looks like it came from the proxy.
TRUST_PROXY_HEADERS=false

# Which reverse proxies in front of the bundled nginx are allowed to tell it
# who the client is. Comma- or space-separated IPs and/or CIDR ranges.
#
# Leave this EMPTY if nothing sits in front of the frontend container — it is
# then the edge, it already sees real client addresses, and naming anything
# here would let that thing forge them.
#
# Set it if you run the documented production topology, where a separate
# TLS-terminating proxy forwards to FRONTEND_HOST_PORT. Every connection then
# arrives from that proxy's address, and unless it is listed here the api sees
# one IP for the entire internet: per-IP rate limits collapse into a single
# shared bucket (one bot probing the login endpoint locks out every real user)
# and the audit log records the proxy on every event.
#
# Only connections *from* these addresses get their X-Forwarded-For believed.
# Anything else reaching the container directly is still pinned to its true
# address, so publishing the port stays safe.
#
#   TRUSTED_PROXIES=10.0.0.4
#   TRUSTED_PROXIES=10.0.0.4,172.18.0.0/16
TRUSTED_PROXIES=

# --- Secrets ----------------------------------------------------------------
# 32-byte key, base64-encoded. Encrypts Plaid access tokens AND every document
# in the vault at rest (AES-GCM). Generate: openssl rand -base64 32
#
# Back this up somewhere other than the server. Losing it costs you the bank
# connections (re-linkable) and every document you have filed (not). There is
# no recovery path — that is what "encrypted at rest" means.
ENCRYPTION_KEY=

# Signs/derives session cookie values. Generate: openssl rand -base64 32
SESSION_SECRET=

# --- Plaid ------------------------------------------------------------------
# sandbox | development | production
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Products an institution MUST support to be offered in Link. Every entry here
# SHRINKS the institution list — Plaid only shows banks supporting all of them —
# so keep this minimal. Almost nobody should change it.
PLAID_PRODUCTS=transactions
# Best-effort products: pulled where the institution and accounts support them,
# ignored where they don't, and never a filter on which banks a user can pick.
# Investments (holdings, the Investments page) and Liabilities (APR and minimum
# payment, which debt-payoff goals need) belong here.
#
# This is also the switch for syncing them, and it applies to accounts that are
# ALREADY linked — enabling a product here starts pulling it on the next sync,
# with no relink and no lost transaction history.
#
# Set it empty to opt out entirely.
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
# Public URL Plaid posts webhooks to. Leave blank to disable webhooks locally.
PLAID_WEBHOOK_URL=

# --- AI provider (Anthropic Messages API-compatible) ------------------------
# Works with GLM, Claude, or any Anthropic-compatible endpoint.
# Leave AI_API_KEY blank to run with AI features disabled — the app is fully
# functional without it (categorization falls back to Plaid's categories).
AI_BASE_URL=https://api.z.ai/api/anthropic
AI_API_KEY=
AI_MODEL=glm-4.6

# --- Push notifications (ntfy) ----------------------------------------------
# The app pushes alerts and digests over ntfy. The SERVER is set here, once,
# for the whole deployment; each user only picks their private topic in the UI
# (Settings -> Notifications). If you self-host ntfy, point this at your own
# instance — otherwise it silently defaults to the PUBLIC https://ntfy.sh and
# your notifications go there under whatever topic each user typed.
NTFY_BASE_URL=https://ntfy.sh
# Optional Bearer token for a protected / self-hosted ntfy server. Leave blank
# for an open server or the public ntfy.sh.
NTFY_TOKEN=

# --- Email (SMTP) -----------------------------------------------------------
# OFF by default, and this one matters more than the other optional switches:
# until SMTP_HOST is set, the app sends NO EMAIL AT ALL. Setting it is how you
# withdraw that guarantee for your own deployment.
#
# The only thing ever mailed is the digest, and only to members who tick
# "Email it to me" in Settings -> Digest. SMTP configured with nobody opted in
# still sends nothing.
#
# Setting SMTP_HOST without SMTP_FROM fails at startup rather than quietly
# having every message rejected.
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS, 25 for a local relay.
SMTP_PORT=587
# Envelope sender and From: header. REQUIRED whenever SMTP_HOST is set.
SMTP_FROM=
# Leave both blank for a relay that needs no authentication.
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (default) | tls (implicit, usually port 465) | none
#
# Both encrypted modes verify the server's certificate against SMTP_HOST. There
# is deliberately no "skip verification" setting: if you have no usable
# certificate, say so honestly with `none` rather than pretending to encrypt.
SMTP_SECURITY=starttls

# --- Benchmark prices (Investments page) ------------------------------------
# OFF by default, and that default is deliberate: this is the only outbound
# request the app makes to a host that is neither Plaid nor your AI provider.
# Turning it on lets a daily job fetch end-of-day index closes from Stooq so the
# Investments page can plot your portfolio against the market. It sends nothing
# but a ticker symbol — no account, balance or transaction data leaves the host.
# With it off, the Investments page still works; the benchmark chart just shows
# your own line alone.
BENCHMARK_PRICES_ENABLED=false
# Which tickers to fetch. US symbols; Stooq is queried as e.g. "spy.us".
BENCHMARK_TICKERS=SPY,VTI,BND,QQQ

# --- Merchant logos ---------------------------------------------------------
# OFF by default. This is the second of the two switches that add a host which
# is neither Plaid nor your AI provider (the other is BENCHMARK_PRICES_ENABLED
# above), and unlike that one it sends a merchant NAME rather than a ticker.
# Read the next two paragraphs before turning it on.
#
# What happens when it is on. Once a day the worker takes the merchants it has
# not seen before and asks your AI provider which website each one is
# ("Blue Bottle Coffee" -> "bluebottlecoffee.com"). It then asks Logo.dev for
# that domain's logo, stores the image in the database, and serves it from this
# app. Both steps happen once per merchant, ever — a merchant with a logo is
# never re-fetched, and a merchant without one is remembered as having none and
# never asked about again.
#
# What leaves the host, precisely. To your AI provider: the merchant's name,
# which it already sees during categorisation — so this step adds no new
# destination. To Logo.dev: a domain, one request per merchant. No amount, no
# balance, no account, no date and no transaction is sent to either, and
# YOUR BROWSER NEVER TALKS TO LOGO.DEV — every image is fetched server-side and
# served from this origin, so the page loads nothing from a third party.
#
# Requires AI_API_KEY: Logo.dev is keyed by domain only, and the AI provider is
# what turns a merchant name into one. The app refuses to start if you enable
# this without a key or a token, rather than silently doing nothing.
#
# With it off (or with no logo found) every merchant shows the app's own
# monogram: a coloured tile with the merchant's first letter, generated locally
# from the name. That is the default imagery and it needs none of this.
#
# Each household can also switch the imagery off for itself in
# Settings -> Appearance, which stops the lookups and deletes what was cached.
MERCHANT_LOGOS_ENABLED=false

# Your Logo.dev PUBLISHABLE key — the one that starts "pk_". NOT the secret key.
# Sign up at https://logo.dev; free tier is 500,000 logo requests a month, no card.
#
# Logo.dev issues two keys and only the publishable one belongs here. This app
# uses exactly one Logo.dev surface: the CDN image endpoint at
# img.logo.dev/{domain}, which authenticates with `?token=pk_...`. The secret key
# (sk_) is for the REST Brand API at api.logo.dev/brand/{domain} — colours,
# socials, descriptions — which costs 5 credits per call (~100 calls/month on
# free) and which this app deliberately does not use. Name-to-domain resolution
# goes through your AI provider instead, specifically so that no part of this
# feature is metered. There is nowhere in this app to put an sk_ key.
#
# Attribution: Logo.dev requires a visible credit only for COMMERCIAL use of the
# free tier. A personal self-hosted instance needs none, and nothing in this app
# renders one. If you deploy this commercially on the free tier, that obligation
# is yours — either add the credit or move to a paid plan.
#
# Publishable or not, it is still a credential: it belongs in this file (which is
# gitignored), never in an image or in source.
LOGO_DEV_TOKEN=

# Requested square size in pixels (Logo.dev's ceiling is 800), and the per-logo
# ceiling on what is stored. The defaults keep a few hundred cached logos small
# enough to ride along in pg_dump without anyone noticing. A response above the
# byte cap is treated as "no logo" rather than an error, because nothing about
# it would be different next time.
MERCHANT_LOGOS_SIZE=128
MERCHANT_LOGOS_MAX_BYTES=128KB

# --- Document vault ---------------------------------------------------------
# Receipts, tax returns, warranties and policies, encrypted with ENCRYPTION_KEY
# and stored beside the transactions they belong to. On by default; it needs
# nothing but a writable directory, which the compose file provides as a volume.
DOCUMENTS_ENABLED=true

# Where the ciphertext goes: "local" (a mounted volume) or "s3".
DOCUMENTS_BACKEND=local

# For the local backend. The compose file mounts the documents-data volume
# here, so leave it alone unless you are running the api outside compose.
#
# IMPORTANT: this directory is NOT in pg_dump. Backing up only the database
# gives you every document's title, type and expiry and none of its contents.
# Back up this volume alongside your dumps. See DEPLOYING.md.
DOCUMENTS_LOCAL_ROOT=/var/lib/ledgermancy/documents

# Per-file cap and per-household total. Accept a plain byte count or a KB/MB/GB
# suffix (binary multiples).
#
# The file cap is not just a tuning knob. Encryption is whole-buffer, so an
# in-flight upload costs roughly twice its own size in memory; the api refuses
# anything above this rather than discovering the limit as an out-of-memory
# crash under a few concurrent uploads. Values above 100MB are rejected at
# startup for that reason. Set the quota to 0 for no household limit.
DOCUMENTS_MAX_FILE_BYTES=25MB
DOCUMENTS_QUOTA_BYTES=2GB

# Receipt OCR. OFF by default, and gated separately from AI_API_KEY on purpose:
# this is the only place the app would send an image of your paperwork off the
# host, and configuring a model for categorisation is not the same as agreeing
# to that.
#
# Even switched on, ONLY documents filed as "receipt" can be sent. Tax
# documents, insurance policies, contracts, statements, warranties and anything
# in "other" are refused by the api before the file is decrypted — a W-2 scanned
# to a PNG is as ineligible as a PDF of one. A receipt is a merchant, a total
# and a date your ledger already knows; a tax return is your SSN. They do not
# share a switch.
#
# What you get is a suggestion: the fields, plus the transactions that amount
# and date could match, with one click to attach the receipt to whichever you
# pick. Nothing is ever written from a model's reading.
DOCUMENTS_OCR_ENABLED=false

# --- Document vault: S3-compatible storage (optional) -----------------------
# Only used when DOCUMENTS_BACKEND=s3. Works with AWS S3, MinIO, Garage or R2.
# Documents are encrypted before they are uploaded, so the bucket never holds
# readable content — but it does hold your data, so this is an outbound
# destination you are choosing deliberately.
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_REGION=us-east-1
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_ACCESS_KEY=
DOCUMENTS_S3_SECRET_KEY=
# Optional key prefix, so one bucket can hold more than this app.
DOCUMENTS_S3_PREFIX=
# Address the bucket as {endpoint}/{bucket}/{key} rather than as a subdomain.
# True is right for every self-hosted S3-compatible server.
DOCUMENTS_S3_PATH_STYLE=true

# --- Retirement sequence-of-returns test ------------------------------------
# OFF by default for a different reason than the fetch above: this makes no
# outbound request at all. It is gated because a "success rate" is the most
# quotable number a retirement tool prints, and no market history is bundled to
# compute one from. What it does instead is draw return sequences around YOUR
# stated real return and volatility and report how many survived the withdrawal
# phase — useful for seeing sequence-of-returns risk, but not a historical
# backtest, and the page says so. The rest of the Retirement page works with
# this off; it adds a panel, nothing more.
RETIREMENT_MONTE_CARLO_ENABLED=false

# --- Backups and continuity -------------------------------------------------
# ON by default, and it is the only optional subsystem in this file that is.
# Every other switch here defaults off because the safe answer is "don't". Here
# the safe answer is "do": an operator who has to opt in to backups is an
# operator who discovers they never did on the day the disk fails. Turning this
# off is a deliberate choice to have no automated recovery path.
#
# What runs, on the interval below:
#   1. pg_dump of the database, custom format (restored with pg_restore)
#   2. a tar.gz of the document vault — pg_dump does NOT contain document
#      contents, only their titles, types and expiry dates
#   3. a portable JSON export: plain, documented, readable without this app
# and on the slower interval, the one that matters most:
#   4. a restore test — the latest dump is restored into a scratch database,
#      row counts are compared table by table, and one document is opened end
#      to end. An untested backup is a belief about a backup.
#
# Status for all of it is on Settings -> Continuity.
BACKUP_ENABLED=true

# Where backups are written. In the Compose deploy this is the backup-data
# volume, mounted into the worker.
BACKUP_DIR=/var/lib/ledgermancy/backups

# An optional SECOND destination. Every artefact is copied here after it is
# written, with its own retention.
#
# Note this is a second location, not necessarily a second machine — and the
# same is true of BACKUP_DIR above. If you have already pointed BACKUP_DIR at a
# NAS mount, your backups are off-host without setting this at all, and that is
# a perfectly good way to run. The app has no way to tell what is underneath
# either path, so it will never claim your backups are or are not on this
# machine; that part is yours to know.
#
# What this buys is a second independent copy, so that losing one location — a
# dead disk, a NAS that ate itself, a directory deleted by accident — is not
# also losing every backup.
#
# Treat whatever you point this at as being exactly as sensitive as the
# database, because it will contain it.
BACKUP_MIRROR_DIR=

# How often the dump, archive and export run.
BACKUP_INTERVAL=24h

# How often the restore test runs. Much less often than the backup itself: it
# restores the whole database into a scratch copy, and what it verifies changes
# with the schema rather than with the calendar. Not so rare that "we tested it
# once, in March" becomes the answer.
BACKUP_RESTORE_TEST_INTERVAL=168h

# Retention, applied to each destination and each artefact kind. The set is
# relative to the backups that exist, not to the clock — so a server that was
# powered off for a month comes back and keeps what it has rather than deciding
# everything is expired.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Archive the document vault alongside the dump. Leave this on unless you are
# backing the document volume up by some other means: with it off, a restore
# gives you a vault where every document is listed and none of them opens.
# Ignored when DOCUMENTS_ENABLED=false.
BACKUP_INCLUDE_DOCUMENTS=true
